{
  "manifest_version": 3,
  "name": "Garry AutoFill — Job Applications",
  "short_name": "Garry AutoFill",
  "version": "1.0.0",
  "description": "Fills job applications on Workday, Greenhouse, Lever, iCIMS, ADP and more from your saved profile. Leaves essay questions for you.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Garry AutoFill",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "permissions": ["storage", "unlimitedStorage", "scripting", "webNavigation", "contextMenus", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/loader.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "fill-page": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Autofill the job application on this page"
    }
  }
}
